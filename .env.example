# Quinde · Gateway. Copia este archivo como .env (nunca se sube .env al repositorio) o pasa las
# variables al contenedor. La tabla completa, con valores de producción, está en docs/DEPLOY.md.

NODE_ENV=development
PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=info

# --- Upstreams: origen de cada servicio (esquema, host y puerto), sin ruta ni barra final --------
# En local, los puertos de docs/E2E-LOCAL.md. En Azure Container Apps, los nombres internos.
UPSTREAM_CORE_URL=http://localhost:3000
UPSTREAM_BFF_URL=http://localhost:4000
UPSTREAM_IDENTITY_URL=http://localhost:3001
UPSTREAM_NOTIFIER_URL=http://localhost:3002

# Plazos por upstream en ms (hasta recibir las cabeceras de la respuesta). Opcionales.
# TIMEOUT_CORE_MS=45000
# TIMEOUT_BFF_MS=50000
# TIMEOUT_IDENTITY_MS=10000
# TIMEOUT_NOTIFIER_MS=10000

# --- Tokens -----------------------------------------------------------------------------------
# iss exacto de los tokens: el JWT_ISSUER de identity_vuelos, texto a texto. En producción es el
# origen público de ESTE gateway (https://api.quinde.example), porque /.well-known va por aquí.
JWT_ISSUER=http://localhost:3001
# aud de los tokens. Opcional; por defecto quinde-vuelos-api.
JWT_AUDIENCE=quinde-vuelos-api
# De dónde se baja el JWKS. Opcional; sin valor: {UPSTREAM_IDENTITY_URL}/.well-known/jwks.json
# (por la red interna, no por el origen público).
JWKS_URL=

# --- Borde ------------------------------------------------------------------------------------
# Orígenes que pueden llamar desde un navegador, separados por coma, sin ruta ni *.
CORS_ORIGINS=http://localhost:5173
# Cuántos proxies de confianza hay delante (0: la IP del socket; 1: el ingress de Azure o Render).
TRUST_PROXY_HOPS=0

# Límite de peticiones por IP y ventana (en memoria: por réplica). Opcionales.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_SECONDS=60
# Límite estricto por IP y por ruta para /oauth2/token, /identity/v1/auth/login y /register.
# RATE_LIMIT_STRICT_MAX=20
# RATE_LIMIT_STRICT_WINDOW_SECONDS=60

# --- Observabilidad (docs/OBSERVABILIDAD.md) -------------------------------------------------
# service.name de las trazas y de quinde_build_info. Opcional; por defecto quinde-gateway.
# OTEL_SERVICE_NAME=quinde-gateway
# Base OTLP/HTTP del recolector (Jaeger all-in-one: http://localhost:4318). Sin valor, las trazas se
# generan y se propagan (traceparent, traceId en los logs, X-Trace-Id) pero no se exportan.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Fracción de trazas que se registran (0 a 1). Opcional; 1.0 en desarrollo y 0.1 en producción.
# OTEL_TRACES_SAMPLER_ARG=1.0
# Continuar el traceparent del cliente en lugar de abrir una traza nueva. Solo si delante hay un
# proxy de confianza que lo genera. Opcional; por defecto false.
# TRACE_TRUST_INCOMING=false
# Puerto APARTE de GET /metrics (Prometheus), que el ingress nunca expone. 0 lo apaga.
METRICS_PORT=9464
